# Atheris fuzz job (.github/workflows/fuzz.yml): atheris plus the runtime
# tree; the package itself installs with --no-deps on top. Atheris ships
# Linux x86_64 wheels only, so this is compiled for that platform:
#   uv pip compile --generate-hashes --python-platform x86_64-manylinux_2_17 \
#     --python-version 3.12 requirements/fuzz.in -o requirements/fuzz.txt
-r runtime.in
atheris>=2.3
