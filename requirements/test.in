# Runtime + test dependencies for the CI "test" job, hash-pinned in
# test.txt so every pip install in .github/workflows is pinned (OpenSSF
# Scorecard Pinned-Dependencies). The package itself installs with
# "pip install --no-deps -e ." on top, which registers the pain001.loaders
# entry point the integration tests discover.
# Regenerate with: make pip-compile
-r runtime.in
pytest>=8
pytest-cov>=5
pytest-benchmark>=5
interrogate>=1.7
# tests/test_check_complexity.py imports the gate, so its tools are here too.
-r complexity.in
